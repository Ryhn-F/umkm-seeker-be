{
  "openapi": "3.0.0",
  "info": {
    "title": "UMKM Seeker API",
    "version": "1.0.0",
    "description": "API Documentation for UMKM Seeker. It includes Authentication, Products, and Orders endpoints."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token in the format: Bearer <token>"
      }
    }
  },
  "paths": {
    "/login": {
      "post": {
        "summary": "Login user",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "test@example.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Login successful",
                  "data": {
                    "user": {
                      "id": 1,
                      "username": "johndoe",
                      "email": "test@example.com"
                    },
                    "token": "eyJhbGciOiJIUz..."
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid email or password" }
        }
      }
    },
    "/register": {
      "post": {
        "summary": "Register user",
        "description": "Registers a new user.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password"],
                "properties": {
                  "username": { "type": "string", "example": "John Doe", "description": "Username" },
                  "email": { "type": "string", "example": "john@example.com", "description": "Email address" },
                  "password": { "type": "string", "example": "password123", "description": "Account password" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration successful",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Registration successful",
                  "data": {
                    "user": {
                      "id": 1,
                      "username": "John Doe",
                      "email": "john@example.com"
                    },
                    "token": "eyJhbGciOiJIUz..."
                  }
                }
              }
            }
          },
          "400": { "description": "Missing required fields or email already registered" }
        }
      }
    },
    "/logout": {
      "post": {
        "summary": "Logout user",
        "tags": ["Auth"],
        "responses": {
          "200": { "description": "Logout successful" }
        }
      }
    },
    "/product": {
      "get": {
        "summary": "Get all products",
        "tags": ["Products"],
        "responses": {
          "200": { "description": "Returns array of products (id, name, image_url, category, price)" }
        }
      }
    },
    "/product/create-product": {
      "post": {
        "summary": "Create a new product",
        "description": "Creates a new product with an image uploaded to Cloudinary. Send as multipart/form-data.",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["name", "stock", "price", "description", "category"],
                "properties": {
                  "name": { "type": "string", "example": "Kopi Susu" },
                  "stock": { "type": "integer", "example": 100 },
                  "price": { "type": "number", "example": 15000 },
                  "description": { "type": "string", "example": "Kopi susu gula aren" },
                  "image": { "type": "string", "format": "binary", "description": "Product image file (jpg, jpeg, png, webp)" },
                  "category": { "type": "string", "example": "Beverage" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Product created successfully" },
          "400": { "description": "Missing required fields" },
          "403": { "description": "Token required" }
        }
      }
    },
    "/product/{id}": {
      "get": {
        "summary": "Get product by ID",
        "tags": ["Products"],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Returns the product details" },
          "404": { "description": "Product not found" }
        }
      },
      "put": {
        "summary": "Update a product",
        "description": "Updates a product. If a new image is provided, the old image is automatically deleted from Cloudinary and replaced.",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Kopi Susu Updated" },
                  "stock": { "type": "integer", "example": 50 },
                  "price": { "type": "number", "example": 18000 },
                  "description": { "type": "string", "example": "Updated description" },
                  "category": { "type": "string", "example": "Beverage" },
                  "image": { "type": "string", "format": "binary", "description": "New product image file (jpg, jpeg, png, webp). Optional. If provided, the old image is deleted from Cloudinary." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Product updated successfully" },
          "403": { "description": "Token required" }
        }
      },
      "delete": {
        "summary": "Delete a product",
        "description": "Deletes a product.",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Product deleted successfully" },
          "403": { "description": "Token required" }
        }
      }
    },
    "/order": {
      "post": {
        "summary": "Create a new order",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["person_name", "no_telp", "id_product", "quantity"],
                "properties": {
                  "person_name": { "type": "string", "example": "John Doe" },
                  "no_telp": { "type": "string", "example": "08123456789" },
                  "id_product": { "type": "array", "items": { "type": "integer" }, "example": [1, 2] },
                  "quantity": { "type": "array", "items": { "type": "integer" }, "example": [4, 2] },
                  "seat_id": { "type": "integer", "example": 1, "description": "Required if making a reservation" },
                  "guest_count": { "type": "integer", "example": 2, "description": "Number of guests" },
                  "reservation_date": { "type": "string", "format": "date", "example": "2026-05-20", "description": "Required if making a reservation" },
                  "reservation_time": { "type": "string", "format": "time", "example": "19:00:00", "description": "Required if making a reservation" },
                  "reservation_end_time": { "type": "string", "format": "time", "example": "21:00:00", "description": "Required if making a reservation" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order created successfully" },
          "400": { "description": "Missing required fields or invalid data" },
          "500": { "description": "Server error" }
        }
      },
      "get": {
        "summary": "Get all orders",
        "tags": ["Orders"],
        "responses": {
          "200": { "description": "Returns array of orders" }
        }
      }
    },
    "/order/{id}": {
      "put": {
        "summary": "Update an order",
        "tags": ["Orders"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "person_name": { "type": "string" },
                  "no_telp": { "type": "string" },
                  "seat_id": { "type": "integer" },
                  "guest_count": { "type": "integer" },
                  "reservation_date": { "type": "string", "format": "date" },
                  "reservation_time": { "type": "string", "format": "time" },
                  "reservation_end_time": { "type": "string", "format": "time" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Order updated successfully" },
          "404": { "description": "Order not found" },
          "500": { "description": "Server error" }
        }
      },
      "delete": {
        "summary": "Delete an order",
        "tags": ["Orders"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Order deleted successfully" },
          "404": { "description": "Order not found" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/seat": {
      "get": {
        "summary": "Get all seats",
        "tags": ["Seats"],
        "responses": {
          "200": { "description": "Returns array of seats (id, seat_number, capacity, status)" }
        }
      },
      "post": {
        "summary": "Create a new seat",
        "tags": ["Seats"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["seat_number", "capacity"],
                "properties": {
                  "seat_number": { "type": "string" },
                  "capacity": { "type": "integer" },
                  "status": { "type": "string", "default": "available" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Seat created successfully" },
          "400": { "description": "Bad request" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/seat/{id}": {
      "put": {
        "summary": "Update a seat",
        "tags": ["Seats"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "seat_number": { "type": "string" },
                  "capacity": { "type": "integer" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Seat updated successfully" },
          "404": { "description": "Seat not found" },
          "500": { "description": "Internal server error" }
        }
      },
      "delete": {
        "summary": "Delete a seat",
        "tags": ["Seats"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Seat deleted successfully" },
          "404": { "description": "Seat not found" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/testimonial": {
      "get": {
        "summary": "Get all testimonials",
        "tags": ["Testimonials"],
        "responses": {
          "200": { "description": "Returns array of testimonials" },
          "500": { "description": "Internal server error" }
        }
      },
      "post": {
        "summary": "Create a new testimonial",
        "tags": ["Testimonials"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "message": { "type": "string" }
                },
                "required": ["name", "message"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Testimonial created successfully" },
          "400": { "description": "Missing required fields" },
          "500": { "description": "Internal server error" }
        }
      }
    }
  }
}
